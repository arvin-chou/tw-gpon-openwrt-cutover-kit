# This file contains no credentials. Copy it to .env and edit only hosts/paths.
GPON_PROFILE=xiaomi-be10000-qwrt-cht
GPON_STICK_HOST=admin@stick.local
GPON_STICK_CONTROL_SOCKET=/absolute/path/to/odi-stick-master.sock
GPON_ROUTER_HOST=root@router.lan
GPON_ROUTER_CONTROL_SOCKET=/absolute/path/to/openwrt-router-master.sock
GPON_EXPECTED_MANUAL_VID=2769
GPON_INTERVAL_SEC=30
GPON_DURATION_SEC=1800
GPON_STATE_DIR=./state

